# Copy this file to .env and fill values for your environment

# Server
PORT=3000
NODE_ENV=development

# OpenAI (optional - used by /api/chat)
#OPENAI_API_KEY=your-openai-api-key

# SMTP (optional - used by /api/contact when CONTACT_TO is set)
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=your-smtp-user
#SMTP_PASS=your-smtp-password
#SMTP_SECURE=false
#SMTP_FROM=No Reply <no-reply@example.com>
#CONTACT_TO=you@example.com

# Mail retry attempts (optional)
#MAIL_RETRY=3

# Admin token for admin API access (set to a strong random value)
#ADMIN_TOKEN=replace-with-strong-token

# Enable server-side analytics endpoint
#ANALYTICS_ENABLED=false
# Copy to .env and set your OpenAI API key if you want server-side AI
OPENAI_API_KEY=your_openai_api_key_here
PORT=3000
ADMIN_TOKEN=change-me-to-a-secure-token
ANALYTICS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
